# Environment variables (copy to .env and fill values)

# OpenAI
OPENAI_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=ai-agent-index

# Server
PORT=3000

# Optional toggles
# If you want to use Supabase/pgvector instead of Pinecone, set USE_SUPABASE=true and add SUPABASE_URL / SUPABASE_KEY
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_KEY=
